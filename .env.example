# ChronoWarden secrets
# Copy this file to .env and fill in values. .env is gitignored — never commit
# real secrets. docker compose auto-loads .env from the project directory.
#
# Postgres credentials (used by the `db` and `api` services).
POSTGRES_USER=chronowarden
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=chronowarden

# Where the database data lives on the host (relative to the compose file).
# DATA_DIR=./data

# Session lifetime for logged-in clients, in days (sliding).
# SESSION_TTL_DAYS=30

# Optional SL Journey Planner API key, forwarded to the upstream API.
# SL_API_KEY=

# Port the front door (proxy) listens on for the host reverse proxy (HAProxy).
# WEB_PORT=8981

# Optional backup-job tuning (defaults are used if omitted).
# CRON_SCHEDULE="0 2 * * *"          # cron expression, default daily 02:00
# RETENTION_DAYS="62"                # keep backups newer than ~2 months
# BACKUP_VOLUME=/opt/appdata/chronowarden/backup  # host dir bind-mounted into backup
