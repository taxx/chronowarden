# ChronoWarden secrets
# Copy this file to .env and fill in values. .env is gitignored — never commit
# real secrets. docker compose auto-loads .env from the project directory.
#
# Postgres credentials. Used by the `db` and `api` services, and by the
# `backup` service (which connects with the same credentials).
# Generate a strong value, e.g.:  openssl rand -base64 36
POSTGRES_USER=chronowarden
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=chronowarden

# Where the database data lives on the host (relative to the compose file).
# DATA_DIR=./data

# Session lifetime for logged-in clients, in days (sliding).
# SESSION_TTL_DAYS=30

# Hard upper bound on a session's age regardless of activity, in days.
# SESSION_ABSOLUTE_TTL_DAYS=90

# Maximum accepted request body size in bytes (default 8 MiB).
# MAX_BODY_BYTES=8388608

# Mark the session cookie Secure. Defaults to true when NODE_ENV=production;
# set false for plain-HTTP local development.
# COOKIE_SECURE=false

# Optional SL Journey Planner API key, forwarded to the upstream API.
# SL_API_KEY=

# Port the front door (proxy) listens on for the host reverse proxy (HAProxy).
# WEB_PORT=8981

# Optional backup-job tuning (defaults are used if omitted).
# CRON_SCHEDULE="0 2 * * *"          # cron expression, default daily 02:00
# RETENTION_DAYS="62"                # keep backups newer than ~2 months
# BACKUP_VOLUME=/opt/appdata/chronowarden/backup  # host dir bind-mounted into backup

# Optional concrete allowed origin for credentialed CORS. Production is
# same-origin behind the proxy and needs none; only set this when the client is
# served from a different origin (e.g. bypassing the Vite dev proxy).
# CORS_ORIGIN=http://localhost:5173
