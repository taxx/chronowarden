# ChronoWarden secrets
# Copy this file to .env and fill in your real Supabase credentials.
# .env is gitignored — never commit real secrets.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# Optional backup-job tuning (defaults are used if omitted).
# CRON_SCHEDULE="0 2 * * *"          # cron expression, default daily 02:00
# RETENTION_DAYS="62"                # keep backups newer than this many days (~2 months)
# BACKUP_VOLUME="/opt/appdata/chronowarden/backup"  # host dir bind-mounted into the backup container
