# Secrets — never commit API credentials
secrets.json
.env
.env.db
.env.edge

# Flutter build output
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies
/build/
*.iml
.metadata

# The apps/ monorepo layout (apps/web + apps/api) is developed on the
# selfhost branch. Ignore it here so switching branches can't accidentally
# stage the new tree; drop this rule when that branch is merged into main.
/apps/

# Build output & dependencies (any depth)
**/node_modules/
**/dist/
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies
**/.metadata

# IDE
.idea/
.vscode/
*.swp
*~

# Mac
.DS_Store

# Android
**/android/.gradle/
**/android/app/src/main/assets/
**/android/local.properties
**/android/*.jks
**/android/key.properties

