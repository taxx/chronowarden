# Supabase Edge Function deployment credentials — gitignored, never commit
# Copy to .env.edge and fill in your Supabase access token.
# Generate a token at: https://supabase.com/dashboard → Account → Access Tokens

SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"

# Optional: SL/Trafiklab subscription key for the sl-proxy Edge Function.
# Set it as a Supabase Edge Function secret if the SL API requires one:
#   supabase secrets set SL_API_KEY="your-key"
# SL_API_KEY=""
