# Database connection credentials for the backup container and AI agent tooling.
# Copy this file to .env.db and fill in your real values.
# This file is gitignored — never commit real secrets.

# Self-hosted Postgres (the `db` service). `db` resolves inside the compose
# network, so this works for the `backup` container. For host-side psql/pg_dump
# use localhost:5432 or `docker compose exec db`.
DB_CONNECTION_STRING="postgresql://chronowarden:YOUR_POSTGRES_PASSWORD@db:5432/chronowarden"
DB_PASSWORD="YOUR_POSTGRES_PASSWORD"

# On the server this file must exist at /opt/appdata/chronowarden/.env.db
# (the docker compose backup service reads it via env_file). It is gitignored.
